# Copie ce dossier :  cp -r boxes/_TEMPLATE boxes/ma-box
# puis édite tout ce qui suit. (Les dossiers commençant par _ sont ignorés par le CLI.)
NAME="ma-box"
CVE="CVE-XXXX-XXXXX"
DIFFICULTY="Easy"          # Easy | Medium | Hard | Insane
CATEGORY="Web / PHP"
PORTS="8090"               # choisis un port host LIBRE, distinct des autres box
URL="http://127.0.0.1:8090"
TAGS="tag1,tag2,cve"
SUMMARY="Une phrase qui décrit la cible, le foothold et la privesc."
